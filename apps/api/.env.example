# Copy to apps/api/.env and fill in.
# Azure Speech is used only for the AI voice, and only on plans with the Azure voice;
# other users hear their browser's built-in voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# Standard voices (cheapest): en-IN-AartiNeural, en-IN-ArjunNeural, en-IN-NeerjaNeural, en-IN-PrabhatNeural.
# AZURE_TTS_RATE (e.g. +10%) speeds them up. HD voices (e.g. en-IN-Neerja:DragonHDLatestNeural) cost ~47% more.
AZURE_TTS_VOICE=en-IN-AartiNeural
AZURE_TTS_RATE=
# Replies containing Hindi (Devanagari) script use this voice; standard English voices can't read it.
AZURE_TTS_VOICE_HINDI=hi-IN-SwaraNeural

# AI model and speech-to-text (all features).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_STT_MODEL=gpt-transcribe

# Sign-in (Supabase Auth). Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Secret key (Settings > API keys; sb_secret_... or service_role): lets account deletion remove the sign-in too.
SUPABASE_SECRET_KEY=
# Only for projects still on the legacy shared JWT secret; leave empty with the newer signing keys.
SUPABASE_JWT_SECRET=

# Payments (Razorpay dashboard > Account & Settings > API Keys). Start with test mode keys (rzp_test_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://<your-api-domain>/v1/payments/webhook, event order.paid, and this secret.
RAZORPAY_WEBHOOK_SECRET=

# Admin page (/admin) password. Use a long random one; admin is disabled while it's empty.
ADMIN_PASSWORD=

# Daily speaking limits, interviews and the voice are set per plan on the admin page.
# Supabase -> Connect -> Transaction pooler (port 6543), with your database password filled in. Vercel needs the pooler.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
WEB_ORIGIN=http://localhost:3000,http://localhost:8081

PLIVO_AUTH_ID=your_auth_id
PLIVO_AUTH_TOKEN=your_auth_token
# AI voice: plivo (Koyal, default; falls back to Azure if a call fails) or azure (Azure only).
TTS_PROVIDER=plivo
# Koyal voice ids (GET https://api.plivo.com/v1/Account/<auth_id>/TTS/Voices/). Defaults: Prerna (en-IN), and
# Meera (hi) for replies containing Hindi script. Other Indian voices: Nisha, Aarav, Karan (en-IN); Ritika, Aman, Ishaan (hi).
PLIVO_TTS_VOICE=3gVUACYdS3ibtu8qPruB
PLIVO_TTS_VOICE_HINDI=6uWzc4xFj31t4jNJUaED