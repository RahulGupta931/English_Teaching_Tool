# Copy to .env and fill in — use the same values as apps/web (NEXT_PUBLIC_* there).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Phone on same Wi-Fi: http://<your-PC-LAN-IP>:8000 (start API with --host 0.0.0.0). Android emulator: http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
